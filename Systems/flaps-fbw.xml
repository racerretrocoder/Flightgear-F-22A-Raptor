<?xml version="1.0"?>

<system name="Flaps FCS">

  <channel name="Flaps">

    <fcs_function name="fcs/flap-ctrl">
      <function>
        <table>
          <independentVar lookup="row">/velocities/airspeed-kt</independentVar>
          <tableData>
              0      0.7
              100    0.7
              200    0.7
              300    0 
              400    0 
              500    0 
              600    0 
              700    0 
          </tableData>
        </table>
      </function>
      <clipto>
        <min>0</min>
        <max>1</max>
      </clipto>
    </fcs_function>
    
    <switch name="fcs/auto-flaps-output">
      <default value="fcs/flap-cmd-norm"/>
      <test logic="OR" value="fcs/flap-cmd-norm">
        /controls/FBW/Switch eq 1
        gear/unit/WOW eq 1
      </test>
      <test logic="OR" value="fcs/flap-ctrl">
        /controls/flight/altflap eq 1
        position/h-agl-ft lt 500
      </test>
      <test logic="OR" value="0">
        fcs/gear-control eq 0
      </test>
    </switch>

    <fcs_function name="fcs/flap-slow-slow">
      <function>
        <product>
          <value>0.1</value>
          <property>hyd/hydrolic-slow</property>
        </product>
      </function>
    </fcs_function>

    <!-- Straight to the flaps xd -->
    <actuator name="flaps delay">
      <input>fcs/auto-flaps-output</input>
      <lag>60</lag>
      <rate_limit>fcs/flap-slow-slow</rate_limit>
      <output>fcs/flap-pos-norm</output>
    </actuator>

    <fcs_function name="Normalized flap output degrees">
        <function>
          <product>
            <property>fcs/flap-pos-norm</property>
            <value>30</value> <!-- Max deflection 30 degrees -->
          </product>
        </function>
        <output>fcs/flap-pos-deg</output>
      </fcs_function>
  </channel>
</system>