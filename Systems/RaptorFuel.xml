<?xml version="1.0"?>  

<system name="Fuel">

  <property value="0">/controls/electric/pump1</property>
  <property value="0">/controls/electric/pump2</property>
  <property value="0">propulsion/tank[0]/flow1</property>
  <property value="0">propulsion/tank[0]/flow2</property>

  <channel name="Fuel pumping">    
    <!-- Tank to pumps -->

    <switch>
      <default value="-0.1"/>
      <test logic="OR" value="0">
        /controls/electric/pump1 EQ 0
        propulsion/tank[0]/contents-lbs LE 0
        propulsion/tank[1]/contents-lbs GE 0.004
        accelerations/Nz LE -0.5
      </test>
      <output>propulsion/tank[0]/flow1</output>
    </switch>
    <switch>
      <default value="-0.1"/>
      <test logic="OR" value="0">
        /controls/electric/pump2 EQ 0
        propulsion/tank[0]/contents-lbs LE 0
        propulsion/tank[2]/contents-lbs GE 0.004
        accelerations/Nz LE -0.5
      </test>
      <output>propulsion/tank[0]/flow2</output>
    </switch>

    <summer>
      <input>propulsion/tank[0]/flow1</input>
      <input>propulsion/tank[0]/flow2</input>
      <output>propulsion/tank[0]/external-flow-rate-pps</output>
    </summer>

    <summer>
      <!-- Tank to pumps1 -->
      <input>-propulsion/tank[0]/flow1</input>
      <output>propulsion/tank[1]/external-flow-rate-pps</output>
    </summer>

    <summer>
      <!-- Tank to pumps2 -->
      <input>-propulsion/tank[0]/flow2</input>
      <output>propulsion/tank[2]/external-flow-rate-pps</output>
    </summer>

  </channel>      

</system>
