<z-m> -1.3 </z-m>
  </offsets>
</model>


<animation> <!--	select animation for Blue aerobatic smoke Pylon7 -->
	<type>select</type>
	<object-name>smokeB</object-name>
	<condition>
		<and>
			
			<equals>
				<property>sim/multiplay/generic/string[16]</property>
				<value>smoke-blue</value>
			</equals>
			<equals>
				<property>sim/multiplay/generic/int[13]</property>
				<value>1</value>
			</equals>
		</and>
	</condition>
</animation>

