<PropertyList>
	
<!--	aerobatic smokes Pylon7 -->
<model><!--	Blue aerobatic smoke Pylon7 -->
  <name>smokeB</name> 
  <path>Aircraft/F-22/Models/Effects/Smoke/aerobatic-smoke/smokeB.xml</path>
  <offsets>
<x-m> 1.05  </x-m>
<y-m> 2.43 </y-m>
<z-m> -1.3 </z-m>
  </offsets>
</model>

<model><!--	Yellow aerobatic smoke Pylon7 -->
