<?xml version="1.0"?>

<PropertyList>

 <path>flare.ac</path>

 <animation>
  <type>billboard</type>
  <spherical>true</spherical>
 </animation>


	<model>
 <name>light</name>
 <path>Aircraft/Generic/spotlight.xml</path>
 <offsets>
			<x-m>-2</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
 </offsets>
 <overlay>
  <params>
   <name>light</name>
   <power-source>f22/mslbright</power-source>
   <direction>
    <x>0</x>
    <y>0</y>
    <z>1</z>
   </direction>
   <ambient>
    <r>1</r>
    <g>0.7</g>
    <b>0</b>
   </ambient>
   <specular>
    <r>1.0</r>
    <g>1.0</g>
    <b>0.5</b>
   </specular>
  </params>
 </overlay>
</model>

	<model>
 <name>light2</name>
 <path>Aircraft/Generic/spotlight.xml</path>
 <offsets>
			<x-m>-2</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
 </offsets>
 <overlay>
  <params>
   <name>RedLightae</name>
   <power-source>f22/mslbright</power-source>
   <direction>
    <x>0</x>
    <y>0</y>
    <z>-1</z>
   </direction>
   <ambient>
    <r>1</r>
    <g>0.7</g>
    <b>0</b>
   </ambient>
   <specular>
    <r>1.0</r>
    <g>1.0</g>
    <b>0.5</b>
   </specular>
  </params>
 </overlay>
</model>


 <model>
  <name>flare_trail</name>
  <path>flare-trail.xml</path>
  <offsets>
   <x-m>0.0</x-m>
   <y-m>0.0</y-m>
   <z-m>0.0</z-m>
  </offsets>
 </model>
